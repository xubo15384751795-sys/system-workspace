{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neutral_pressure_md.model_result.v1",
  "title": "Neutral pressure M/D plugin result",
  "type": "object",
  "required": [
    "protocol_version",
    "model_id",
    "model_version",
    "as_of",
    "available_at",
    "status",
    "confidence",
    "state",
    "scores",
    "diagnostics",
    "model_payload",
    "provenance",
    "input_digest",
    "implementation_digest",
    "authority",
    "claim_ceiling",
    "diagnostic_only"
  ],
  "properties": {
    "protocol_version": {"const": "measurement.model.v1"},
    "model_id": {"const": "neutral_pressure_md"},
    "model_version": {"type": "string"},
    "as_of": {"type": ["string", "null"]},
    "available_at": {"type": ["string", "null"]},
    "status": {"type": "string"},
    "confidence": {"type": ["number", "null"]},
    "state": {"type": ["string", "null"]},
    "scores": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "diagnostics": {"type": "object"},
    "model_payload": {"type": "object"},
    "provenance": {"type": "object"},
    "input_digest": {"type": "string"},
    "implementation_digest": {"type": "string"},
    "authority": {"const": "DIAGNOSTIC_ONLY"},
    "claim_ceiling": {"type": "string"},
    "diagnostic_only": {"const": true}
  },
  "additionalProperties": false
}
