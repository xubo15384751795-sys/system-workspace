<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Phase 0.3 + 2.3 staged plist.
     Apply via: bash scripts/install_launchd_plists.sh (pass apply flag).
     Changes vs older installed agent:
       0.3: 21:30 run uses skip-harvester (no provider acquisition; 06:30 is the warm-up).
       2.3: logs under Output/logs/launchd/ (monthly truncate by daily_run). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.system.daily-run-harvester-postclose</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>/Users/a1/System/scripts/daily_run.py</string>
        <string>--skip-harvester</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/a1/System/system-learning-hub/src</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <!-- 21:30 local: optional downstream-only run; never acquire data -->
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/a1/System</string>
    <key>StandardOutPath</key>
    <string>/Users/a1/System/Output/logs/launchd/daily_run_harvester_postclose.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/a1/System/Output/logs/launchd/daily_run_harvester_postclose.log</string>
    <!-- launchd soft maxfiles defaults near 256; harvester/yfinance need headroom -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
</dict>
</plist>
