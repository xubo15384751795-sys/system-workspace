# Copy this file to ~/.config/system/observability.env and chmod 600.
# The launchd wrapper parses KEY=VALUE entries; it never executes this file.
# Leave a key absent rather than committing or storing an empty placeholder.

# Sentry error/event sink.
# SENTRY_DSN=https://<public-key>@<sentry-host>/<project-id>
# SENTRY_ENVIRONMENT=system-launchd

# Feishu bot used for one daily summary and dead-man alerts.
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/<token>

# Optional healthchecks.io heartbeat sink.
# HEALTHCHECKS_DAILY_RUN_URL=https://hc-ping.com/<uuid>
