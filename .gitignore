# ── Workspace-level gitignore (system-workspace) ─────────────────────────
# Sister repos are git submodules — tracked via .gitmodules, not listed here.
# Policy: governance/git_workspace_policy.md

# External tooling installs (not submodules)
OpenBB/

# Compatibility symlinks — recreated by scripts/bootstrap.sh
Structural Research Harness
Structural Risk Harvester
System Learning Hub
/contracts

# ExternalTools: keep qlib_benchmark_runner sources in this repo, ignore other
# external tooling (e.g. OpenBB venv-style installs)
ExternalTools/*
!ExternalTools/qlib_benchmark_runner/
ExternalTools/qlib_benchmark_runner/.venv/
ExternalTools/qlib_benchmark_runner/__pycache__/

# Large / generated data — never commit, except small runtime seed/config
# files required for a clean checkout to run its tests and default assembly.
/Data/*
!/Data/system_learning/
/Data/system_learning/*
!/Data/system_learning/registries/
/Data/system_learning/registries/*
!/Data/system_learning/registries/governance_status_registry.yaml
!/Data/system_learning/registries/issue_registry.yaml
!/Data/system_learning/registries/routing_rules.yaml
!/Data/system_learning/registries/verification_policy.yaml
!/Data/structural_lab/
/Data/structural_lab/*
!/Data/structural_lab/nlp/
!/Data/structural_lab/nlp/mapping_rules.yaml
!/Data/structural_lab/nlp/case_library/
!/Data/structural_lab/nlp/case_library/*.json
/Output/

# Nested generated artifacts (keep similarly named source packages trackable)
/Visualization/data/
/Visualization/output/
/packages/Output/
/paper-empirical-interface/output/

# ── Qlib benchmark sandbox isolation ────────────────────────────────────
# Qlib workspace and output are large intermediate artifacts — never commit
Output/benchmarks/market_feedback/*/qlib_workspace/
Output/benchmarks/market_feedback/*/qlib_output/
Output/benchmarks/market_feedback/*/sandbox_input/*.parquet
Output/benchmarks/market_feedback/*/sandbox_input/*.csv
# Keep manifests, feedback decisions, and events (small governance artifacts)
!Output/benchmarks/market_feedback/*/benchmark_manifest.json
!Output/benchmarks/market_feedback/*/sandbox_input/sandbox_input_manifest.json
!Output/benchmarks/market_feedback/*/qlib_job_spec.json
!Output/benchmarks/market_feedback/*/feedback/
!Output/benchmarks/market_feedback/*/events/
!Output/benchmarks/market_feedback/*/isolation_audit.json
!Output/benchmarks/market_feedback/*/gate_result.json
# Never commit Qlib venv
ExternalTools/qlib_benchmark_runner/.venv/

# Python caches
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual environments
.venv/
venv/
.env/
*.venv

# Environment / secrets — never commit
.env
.env.*
*.env
*.secret.json
*.secret.yaml
*.secret.toml
*.local.json
*.local.yaml
*.local.toml
config/*local*
.claude/
.opencode/

# Database / binary artifacts
*.duckdb
*.duckdb.wal
*.parquet
*.db
*.sqlite

# IDE
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Logs
*.log
lightning_logs/

# Phase 3.3: agent/tooling working dirs (not source)
.zcode/
.cursor/checkpoints/
