{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-risk-harvester.local/schemas/provenance/1.0",
  "title": "Harvester Dataset Provenance",
  "description": "Per-dataset provenance record. One provenance file per dataset per release, located at <release_root>/provenance/<dataset_id>.provenance.json. Records the full acquisition and transformation history, including failed attempts, for audit purposes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_revision",
    "release_id",
    "acquisition",
    "transformations",
    "checksums"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Provenance schema version, MAJOR.MINOR. Phase 2 freezes at 1.0."
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "dataset_revision": {
      "type": "integer",
      "minimum": 1
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source_identifier", "started_at", "completed_at", "operator"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["http_get", "http_post", "ftp", "sftp", "file_copy", "manual_upload", "api_client", "computed"],
          "description": "How the raw data was obtained. 'computed' indicates a derived dataset with no external acquisition."
        },
        "source_identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Canonical identifier of the source: URL, file path, API endpoint, or upstream dataset reference."
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the acquisition attempt sequence started."
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the final successful acquisition completed."
        },
        "operator": {
          "type": "string",
          "description": "Identifier of the human or automated agent that performed the acquisition."
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attempt_number", "started_at", "outcome"],
            "properties": {
              "attempt_number": { "type": "integer", "minimum": 1 },
              "started_at": { "type": "string", "format": "date-time" },
              "ended_at": { "type": "string", "format": "date-time" },
              "outcome": {
                "type": "string",
                "enum": ["success", "failed_network", "failed_auth", "failed_schema", "failed_other", "retried"]
              },
              "note": { "type": "string", "maxLength": 1000 }
            }
          },
          "description": "Append-only record of all acquisition attempts including failed ones. Required if more than one attempt was made."
        },
        "internal_reference": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "raw_path": {
              "type": "string",
              "description": "Path under data/raw/ where the unmodified source bytes are stored. Out-of-scope for consumers; recorded for audit only."
            },
            "processed_path": {
              "type": "string",
              "description": "Path under data/processed/ if intermediate processing artifacts are kept."
            }
          },
          "description": "References to provider-internal storage. NOT consumer-visible. Audit use only."
        },
        "sources": {
          "type": "array",
          "description": "Observation-only per-source/series acquisition timings. Does not affect admission or fetch behavior.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "started_at", "completed_at", "elapsed_s", "attempts", "outcome"],
            "properties": {
              "source_id": { "type": "string", "minLength": 1 },
              "series_id": { "type": "string", "minLength": 1 },
              "provider": { "type": "string", "minLength": 1 },
              "started_at": { "type": "string", "format": "date-time" },
              "completed_at": { "type": "string", "format": "date-time" },
              "elapsed_s": { "type": "number", "minimum": 0 },
              "attempts": { "type": "integer", "minimum": 0 },
              "outcome": {
                "type": "string",
                "enum": ["success", "failed", "manual"]
              }
            }
          }
        },
        "local_steps": {
          "type": "array",
          "description": "Observation-only timings for local release work such as JSONL writes and finalize validation.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "started_at", "completed_at", "elapsed_s", "attempts", "outcome"],
            "properties": {
              "step_id": { "type": "string", "minLength": 1 },
              "started_at": { "type": "string", "format": "date-time" },
              "completed_at": { "type": "string", "format": "date-time" },
              "elapsed_s": { "type": "number", "minimum": 0 },
              "attempts": { "type": "integer", "minimum": 0 },
              "outcome": {
                "type": "string",
                "enum": ["success", "failed"]
              }
            }
          }
        }
      }
    },
    "transformations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "code_reference", "started_at", "outcome"],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "description": "Sequence number of the transformation step."
          },
          "name": {
            "type": "string",
            "description": "Short identifier for this transformation step."
          },
          "code_reference": {
            "type": "string",
            "description": "Reference to the code that performed the transformation, e.g. 'harvester.providers.nfci:parse_v2' or a git commit + path."
          },
          "params": {
            "type": "object",
            "description": "Parameters passed to the transformation. Free-form."
          },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time" },
          "outcome": {
            "type": "string",
            "enum": ["success", "failed", "skipped"]
          },
          "note": { "type": "string", "maxLength": 2000 },
          "input_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "sha256 of the input to this step, if applicable."
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "sha256 of the output of this step, if applicable."
          }
        }
      },
      "description": "Ordered list of transformations applied between raw acquisition and the final data file. Empty array is valid (raw == final)."
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_sha256"],
      "properties": {
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the originally acquired bytes, before any transformation."
        },
        "final_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the final data file. MUST match the dataset manifest's data_file.sha256."
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harvester_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "python_version": { "type": "string" },
        "platform": { "type": "string" },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      },
      "description": "Optional environment metadata for reproducibility."
    },
    "provider_outcome": {
      "$ref": "#/$defs/provider_outcome",
      "description": "Structured acquisition outcome for provider-backed datasets."
    },
    "observation_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "time_column"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "time_column": { "type": "string", "minLength": 1 }
      },
      "description": "Actual observation interval derived from the final data bytes."
    },
    "availability": {
      "$ref": "#/$defs/availability",
      "description": "Explicit publication, availability, retrieval, and calendar clocks for the release."
    },
    "integrity": {
      "$ref": "#/$defs/integrity",
      "description": "Primary-key and duplicate-row integrity evidence for the release."
    },
    "canonical_observation_path": {
      "type": "string",
      "pattern": "^provenance/[^/]+\\.canonical_observations\\.jsonl$",
      "description": "Release-relative JSONL file containing canonical Observation records."
    },
    "canonical_observation_count": {
      "type": "integer",
      "minimum": 0
    },
    "canonical_chain_path": {
      "type": "string",
      "pattern": "^provenance/[^/]+\\.canonical_chains\\.jsonl$",
      "description": "Release-relative JSONL file containing complete canonical Observation -> Measurement -> Evidence -> Claim records."
    },
    "canonical_chain_count": {
      "type": "integer",
      "minimum": 0
    },
    "canonical_schema_version": {
      "type": "string",
      "enum": ["system.canonical_chain.v1", "system.canonical_chain.v2"],
      "description": "v1 is a full JSONL dump. v2 is delta JSONL plus a lineage digest sidecar. Record bodies remain system.canonical_chain.v1."
    },
    "canonical_lineage_path": {
      "type": "string",
      "pattern": "^provenance/[^/]+\\.canonical_lineage\\.v2\\.json$",
      "description": "Release-relative v2 lineage envelope with previous_release_id and Merkle digests."
    },
    "previous_release_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$",
      "description": "Prior release that this v2 delta applies on top of."
    },
    "canonical_observation_delta_count": {
      "type": "integer",
      "minimum": 0
    },
    "canonical_chain_delta_count": {
      "type": "integer",
      "minimum": 0
    },
    "canonical_observation_merkle_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonical_chain_merkle_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measurement_spec_path": {
      "type": "string",
      "pattern": "^provenance/[^/]+\\.measurement_spec\\.json$",
      "description": "Release-relative JSON file containing a target-specific measurement specification."
    },
    "measurement_spec_version": {
      "type": "string",
      "const": "system.measurement_spec.v1"
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "$defs": {
    "provider_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider", "requested_count", "succeeded_count", "failed_count", "retrieved_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "refreshed",
            "reused_same_content",
            "reused_after_provider_failure",
            "partial_provider_success",
            "provider_failed_no_acceptable_fallback",
            "no_release_expected",
            "environmentally_blocked"
          ]
        },
        "provider": { "type": "string", "minLength": 1 },
        "requested_count": { "type": "integer", "minimum": 0 },
        "succeeded_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "failed_series": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "fallback_reason": { "type": "string", "maxLength": 2000 },
        "error": { "type": "string", "maxLength": 2000 },
        "availability": { "$ref": "#/$defs/availability" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "route_policy": { "$ref": "#/$defs/route_policy" },
        "data_contract": { "$ref": "#/$defs/data_contract" },
        "series_source_signatures": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/source_signature" }
        },
        "providers_used": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "series_providers": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "series_attempts": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "reason", "error"],
              "properties": {
                "provider_attempt_id": {
                  "type": "string",
                  "pattern": "^att_[0-9a-f]{32}$"
                },
                "attempt_number": { "type": "integer", "minimum": 1 },
                "provider": { "type": "string", "minLength": 1 },
                "source_id": { "type": "string", "minLength": 1 },
                "source_engine": { "type": "string", "minLength": 1 },
                "source_url": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "source_tier": { "type": "integer", "minimum": 1 },
                "reason": { "type": "string", "minLength": 1 },
                "error": { "type": "string", "maxLength": 300 },
                "outcome": { "type": "string", "enum": ["success", "failed"] },
                "retryable": { "type": "boolean" },
                "failure_class": {
                  "type": "string",
                  "enum": ["NONE", "NO_DATA", "PROVIDER_DOWN", "NETWORK", "SCHEMA_CHANGED", "PARSER", "PERMISSION", "RATE_LIMIT", "UNKNOWN"]
                }
              }
            }
          }
        },
        "prefetched_series": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "prefetch_owner": {
          "type": "string",
          "minLength": 1
        },
        "provider_chain": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "fallback_used": { "type": "boolean" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "carry_forward_reason": {
          "type": "string",
          "const": "deadline",
          "description": "Set when remaining series were skipped because the concurrent acquisition budget expired."
        },
        "deadline_skipped_series": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "calendar_status", "available_at", "retrieved_at", "decision_usable", "reason"],
      "properties": {
        "state": { "type": "string", "enum": ["AVAILABLE", "STALE", "DELAYED", "MISSING", "NOT_APPLICABLE", "SOURCE_DOWN", "SCHEMA_CHANGED", "DISCONTINUED", "UNKNOWN"] },
        "calendar_status": { "type": "string", "enum": ["CONFIGURED", "UNCONFIGURED"] },
        "published_at": { "type": ["string", "null"], "format": "date-time" },
        "available_at": { "type": ["string", "null"], "format": "date-time" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "decision_usable": { "type": "boolean" },
        "reason": { "type": "string", "maxLength": 500 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_key": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "rows_before": { "type": "integer", "minimum": 0 },
        "rows_after": { "type": "integer", "minimum": 0 },
        "duplicate_rows_removed": { "type": "integer", "minimum": 0 },
        "duplicate_key_count": { "type": "integer", "minimum": 0 },
        "counter_scope": { "type": "string", "enum": ["single_boundary", "aggregate_across_boundaries"] },
        "boundary_count": { "type": "integer", "minimum": 0 }
      }
    },
    "route_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["route_class", "diagnostic_only", "promotion_allowed", "decision_usable", "reason"],
      "properties": {
        "route_class": { "type": "string", "minLength": 1 },
        "selected_providers": { "type": "array", "items": { "type": "string" } },
        "authoritative_providers": { "type": "array", "items": { "type": "string" } },
        "diagnostic_providers": { "type": "array", "items": { "type": "string" } },
        "diagnostic_only": { "type": "boolean" },
        "promotion_allowed": { "type": "boolean" },
        "decision_usable": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "parity_certified": { "type": "boolean" }
      }
    },
    "data_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "contract_id", "status", "violations", "warnings"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "contract_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "WARN", "BLOCK"] },
        "violations": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "normalization_profile", "adjusted", "timestamp_basis"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "normalization_profile": { "type": "string", "minLength": 1 },
        "adjusted": { "type": "boolean" },
        "timestamp_basis": { "type": "string", "minLength": 1 },
        "cache_hit": { "type": "boolean" }
      }
    }
  }
}
