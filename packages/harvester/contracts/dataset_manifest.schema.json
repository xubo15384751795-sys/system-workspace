{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://structural-risk-harvester.local/schemas/dataset_manifest/1.0",
  "title": "Harvester Dataset Manifest",
  "description": "Per-dataset manifest. One manifest per dataset per release, located at <release_root>/manifests/<dataset_id>.manifest.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_revision",
    "release_id",
    "as_of_date",
    "vintage_date",
    "source",
    "data_file",
    "columns",
    "time_coverage",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Manifest schema version, MAJOR.MINOR. Phase 2 freezes at 1.0."
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "description": "Stable identifier. Must match the dataset_id in catalog.json."
    },
    "dataset_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Revision number within the release. Must match catalog entry."
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$",
      "description": "release_id this manifest belongs to. Must match the enclosing release directory."
    },
    "as_of_date": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date describing the world state the data refers to."
    },
    "vintage_date": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date the data was observed, published, or otherwise recorded. Independent of as_of_date. Used for no-lookahead enforcement."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "kind", "retrieved_at"],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the source provider, e.g. 'Federal Reserve Bank of Chicago', 'OFR', 'Brevan Howard internal note'."
        },
        "kind": {
          "type": "string",
          "enum": ["public_api", "public_file", "subscription", "internal_corpus", "manual_curation", "derived"],
          "description": "Acquisition kind. 'derived' indicates the dataset is computed from other Harvester datasets."
        },
        "url_or_reference": {
          "type": "string",
          "maxLength": 2000,
          "description": "Canonical URL or human-readable reference to the source. Optional but strongly recommended."
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the source was accessed."
        },
        "available_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when the provider made this observation available."
        },
        "license": {
          "type": "string",
          "description": "License or terms-of-use identifier, if known."
        },
        "access_notes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Free-form notes about access conditions, restrictions, or caveats."
        }
      }
    },
    "data_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format", "sha256", "byte_size"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^data/[^/]+\\.[a-z0-9]+$",
          "description": "Path to the data file, relative to the release root."
        },
        "format": {
          "type": "string",
          "enum": ["parquet", "csv", "tsv", "jsonl", "json", "duckdb", "feather", "arrow"],
          "description": "File format identifier."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Lowercase hex sha256 of the file's bytes."
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0,
          "description": "Size of the file in bytes."
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of rows. Optional but recommended for tabular formats."
        },
        "compression": {
          "type": "string",
          "enum": ["none", "gzip", "zstd", "snappy", "lz4"],
          "description": "Compression codec, if any. Default 'none'."
        }
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/column_spec" },
      "description": "Column specifications. Required even for non-tabular formats; for non-tabular data, list the top-level fields."
    },
    "time_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "frequency"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date",
          "description": "Earliest date covered by the data, inclusive."
        },
        "end": {
          "type": "string",
          "format": "date",
          "description": "Latest date covered by the data, inclusive."
        },
        "frequency": {
          "type": "string",
          "enum": ["irregular", "daily", "business_daily", "weekly", "monthly", "quarterly", "annual", "intraday"],
          "description": "Sampling frequency."
        },
        "time_column": {
          "type": "string",
          "description": "Name of the column carrying the time index. Required for tabular data with time series."
        }
      }
    },
    "quality_report_path": {
      "type": "string",
      "pattern": "^quality_reports/[^/]+\\.quality\\.json$",
      "description": "Optional path to the quality report, relative to release root."
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance_path"],
      "properties": {
        "provenance_path": {
          "type": "string",
          "pattern": "^provenance/[^/]+\\.provenance\\.json$",
          "description": "Path to the provenance file, relative to release root."
        },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["upstream"],
          "properties": {
            "upstream": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["release_id", "dataset_id"],
                "properties": {
                  "release_id": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"
                  },
                  "dataset_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
                  },
                  "dataset_revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "description": "Upstream Harvester datasets this dataset is derived from."
            },
            "method_reference": {
              "type": "string",
              "description": "Identifier or path of the derivation method (e.g., a code reference, a documented method ID)."
            }
          },
          "description": "Required if and only if source.kind == 'derived'."
        }
      }
    },
    "provider_outcome": {
      "$ref": "#/$defs/provider_outcome",
      "description": "Structured acquisition outcome for provider-backed datasets."
    },
    "notes": {
      "type": "string",
      "maxLength": 4000,
      "description": "Free-form notes. Not consumed programmatically."
    }
  },
  "$defs": {
    "provider_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider", "requested_count", "succeeded_count", "failed_count", "retrieved_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "refreshed",
            "reused_same_content",
            "reused_after_provider_failure",
            "partial_provider_success",
            "provider_failed_no_acceptable_fallback",
            "no_release_expected",
            "environmentally_blocked"
          ]
        },
        "provider": { "type": "string", "minLength": 1 },
        "requested_count": { "type": "integer", "minimum": 0 },
        "succeeded_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "failed_series": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "fallback_reason": { "type": "string", "maxLength": 2000 },
        "error": { "type": "string", "maxLength": 2000 },
        "available_at": { "type": ["string", "null"], "format": "date-time" },
        "availability": { "$ref": "#/$defs/availability" },
        "integrity": { "$ref": "#/$defs/integrity" },
        "route_policy": { "$ref": "#/$defs/route_policy" },
        "data_contract": { "$ref": "#/$defs/data_contract" },
        "series_source_signatures": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/source_signature" }
        },
        "providers_used": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "series_providers": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "series_attempts": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "reason", "error"],
              "properties": {
                "provider_attempt_id": {
                  "type": "string",
                  "pattern": "^att_[0-9a-f]{32}$"
                },
                "attempt_number": { "type": "integer", "minimum": 1 },
                "provider": { "type": "string", "minLength": 1 },
                "source_id": { "type": "string", "minLength": 1 },
                "source_engine": { "type": "string", "minLength": 1 },
                "source_url": { "type": "string", "minLength": 1, "maxLength": 2000 },
                "source_tier": { "type": "integer", "minimum": 1 },
                "reason": { "type": "string", "minLength": 1 },
                "error": { "type": "string", "maxLength": 300 },
                "outcome": { "type": "string", "enum": ["success", "failed"] },
                "retryable": { "type": "boolean" },
                "failure_class": {
                  "type": "string",
                  "enum": ["NONE", "NO_DATA", "PROVIDER_DOWN", "NETWORK", "SCHEMA_CHANGED", "PARSER", "PERMISSION", "RATE_LIMIT", "UNKNOWN"]
                }
              }
            }
          }
        },
        "prefetched_series": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "prefetch_owner": {
          "type": "string",
          "minLength": 1
        },
        "provider_chain": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "fallback_used": { "type": "boolean" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "carry_forward_reason": {
          "type": "string",
          "const": "deadline"
        },
        "deadline_skipped_series": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "calendar_status", "available_at", "retrieved_at", "decision_usable", "reason"],
      "properties": {
        "state": { "type": "string", "enum": ["AVAILABLE", "STALE", "DELAYED", "MISSING", "NOT_APPLICABLE", "SOURCE_DOWN", "SCHEMA_CHANGED", "DISCONTINUED", "UNKNOWN"] },
        "calendar_status": { "type": "string", "enum": ["CONFIGURED", "UNCONFIGURED"] },
        "published_at": { "type": ["string", "null"], "format": "date-time" },
        "available_at": { "type": ["string", "null"], "format": "date-time" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "decision_usable": { "type": "boolean" },
        "reason": { "type": "string", "maxLength": 500 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary_key": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "rows_before": { "type": "integer", "minimum": 0 },
        "rows_after": { "type": "integer", "minimum": 0 },
        "duplicate_rows_removed": { "type": "integer", "minimum": 0 },
        "duplicate_key_count": { "type": "integer", "minimum": 0 },
        "counter_scope": { "type": "string", "enum": ["single_boundary", "aggregate_across_boundaries"] },
        "boundary_count": { "type": "integer", "minimum": 0 }
      }
    },
    "route_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["route_class", "diagnostic_only", "promotion_allowed", "decision_usable", "reason"],
      "properties": {
        "route_class": { "type": "string", "minLength": 1 },
        "selected_providers": { "type": "array", "items": { "type": "string" } },
        "authoritative_providers": { "type": "array", "items": { "type": "string" } },
        "diagnostic_providers": { "type": "array", "items": { "type": "string" } },
        "diagnostic_only": { "type": "boolean" },
        "promotion_allowed": { "type": "boolean" },
        "decision_usable": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 },
        "parity_certified": { "type": "boolean" }
      }
    },
    "data_contract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "contract_id", "status", "violations", "warnings"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "contract_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "WARN", "BLOCK"] },
        "violations": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "normalization_profile", "adjusted", "timestamp_basis"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "normalization_profile": { "type": "string", "minLength": 1 },
        "adjusted": { "type": "boolean" },
        "timestamp_basis": { "type": "string", "minLength": 1 },
        "cache_hit": { "type": "boolean" }
      }
    },
    "column_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "nullable"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Column name as it appears in the data file."
        },
        "dtype": {
          "type": "string",
          "enum": [
            "int8", "int16", "int32", "int64",
            "uint8", "uint16", "uint32", "uint64",
            "float32", "float64",
            "bool",
            "string",
            "date", "datetime", "timestamp_tz",
            "category",
            "binary",
            "json"
          ],
          "description": "Logical data type. Implementations map to physical types per format."
        },
        "nullable": {
          "type": "boolean",
          "description": "Whether the column may contain null values."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Human-readable description of the column."
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement, e.g. 'percent', 'basis_points', 'usd'."
        },
        "semantic_role": {
          "type": "string",
          "enum": ["time_index", "primary_key", "foreign_key", "measure", "category", "identifier", "metadata"],
          "description": "Role of the column in the dataset's logical structure."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source": { "properties": { "kind": { "const": "derived" } } } },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "lineage": {
            "required": ["provenance_path", "derivation"]
          }
        }
      }
    }
  ]
}
