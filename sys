#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
CURRENT="$ROOT/Output/current"
cmd="${1:-check}"

case "$cmd" in
  refresh)
    python3 "$ROOT/scripts/refresh_output_current.py"
    python3 "$ROOT/scripts/build_artifact_navigator.py"
    ;;
  check|current)
    if [ ! -f "$CURRENT/00_READ_ME_FIRST.md" ]; then
      echo "Output/current is missing. Run:"
      echo "  ./sys refresh"
      exit 1
    fi
    sed -n '1,55p' "$CURRENT/00_READ_ME_FIRST.md"
    ;;
  open)
    if [ ! -f "$CURRENT/00_READ_ME_FIRST.md" ]; then
      echo "Output/current is missing. Running refresh first..."
      python3 "$ROOT/scripts/refresh_output_current.py"
    fi
    open "$CURRENT/00_READ_ME_FIRST.md"
    if [ -e "$CURRENT/latest_report.html" ]; then
      open "$CURRENT/latest_report.html"
    fi
    ;;
  next|learning)
    if [ ! -e "$CURRENT/next_actions.md" ]; then
      echo "Missing next_actions.md. Run:"
      echo "  ./sys refresh"
      exit 1
    fi
    sed -n '1,80p' "$CURRENT/next_actions.md"
    ;;
  evidence)
    python3 "$ROOT/scripts/build_benchmark_evidence_dashboard.py"
    if [ -e "$CURRENT/benchmark_evidence_dashboard.md" ]; then
      sed -n '1,80p' "$CURRENT/benchmark_evidence_dashboard.md"
    elif [ -e "$CURRENT/benchmark_evidence_dashboard.html" ]; then
      open "$CURRENT/benchmark_evidence_dashboard.html"
    fi
    ;;
  explain)
    if [ ! -f "$CURRENT/00_READ_ME_FIRST.md" ]; then
      echo "Output/current is missing. Run:"
      echo "  ./sys refresh"
      exit 1
    fi
    sed -n '/^## Framework Diagnosis/,$p' "$CURRENT/00_READ_ME_FIRST.md" | sed -n '1,45p'
    ;;
  ask)
    shift || true
    if [ "$#" -eq 0 ]; then
      echo "Usage: ./sys ask \"question\""
      exit 1
    fi
    python3 "$ROOT/scripts/ask_evidence.py" "$@"
    ;;
  artifacts)
    python3 "$ROOT/scripts/build_artifact_navigator.py"
    if [ -e "$CURRENT/artifact_navigator.md" ]; then
      open "$CURRENT/artifact_navigator.md"
    fi
    ;;
  validate-contract)
    shift || true
    python3 "$ROOT/scripts/validate_workbench_contract.py" "$@"
    ;;
  report)
    if [ ! -e "$CURRENT/latest_report.html" ]; then
      echo "Missing latest_report.html. Run:"
      echo "  ./sys refresh"
      exit 1
    fi
    open "$CURRENT/latest_report.html"
    ;;
  doctor)
    echo "Checking Output/current..."
    test -d "$CURRENT"
    test -f "$CURRENT/00_READ_ME_FIRST.md"
    realpath "$CURRENT/latest_run" >/dev/null
    realpath "$CURRENT/latest_summary.md" >/dev/null
    realpath "$CURRENT/latest_report.html" >/dev/null
    realpath "$CURRENT/latest_dashboard.json" >/dev/null
    realpath "$CURRENT/run_manifest.json" >/dev/null
    test -f "$CURRENT/model_run.json"
    echo "OK: Output/current looks usable."
    ;;
  status)
    python3 "$ROOT/scripts/system_status.py"
    ;;
  framework)
    shift || true
    python3 "$ROOT/scripts/framework_cli.py" "$@"
    ;;
  *)
    echo "Usage:"
    echo "  ./sys check     Show current risk check"
    echo "  ./sys current   Alias for check"
    echo "  ./sys evidence  Show evidence indicators and provenance"
    echo "  ./sys explain   Show framework-specific diagnosis"
    echo "  ./sys ask       Ask a grounded question over current evidence"
    echo "  ./sys open      Open current dashboard/report"
    echo "  ./sys next      Show next actions"
    echo "  ./sys doctor    Validate current pointers"
    echo "  ./sys refresh   Refresh Output/current"
    echo "  ./sys artifacts Build/open artifact navigator"
    echo "  ./sys validate-contract <kind> <path>"
    echo "  ./sys learning  Alias for next"
    echo "  ./sys report    Open latest HTML report"
    echo "  ./sys status    Show workspace subsystem status"
    echo "  ./sys framework list|register|unregister  Manage analysis frameworks"
    exit 1
    ;; 
esac
