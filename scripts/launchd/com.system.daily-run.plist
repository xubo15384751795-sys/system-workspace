<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.system.daily-run</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SYSTEM_PYTHON__</string>
    <string>__SYSTEM_ROOT__/scripts/run_with_runtime_secrets.py</string>
    <string>/bin/bash</string>
    <string>__SYSTEM_ROOT__/scripts/run_daily_scheduled.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__SYSTEM_ROOT__/Output/runs/launchd-daily-run.log</string>
  <key>StandardErrorPath</key>
  <string>__SYSTEM_ROOT__/Output/runs/launchd-daily-run.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>UTC</string>
    <key>SYSTEM_ROOT</key>
    <string>__SYSTEM_ROOT__</string>
    <key>PAPER_ROOT</key>
    <string>__PAPER_ROOT__</string>
    <key>HORIZON_ROOT</key>
    <string>__HORIZON_ROOT__</string>
    <key>SYSTEM_ORCHESTRATOR</key>
    <string>dagster</string>
    <key>PYTHONPATH</key>
    <string>__SYSTEM_ROOT__:__SYSTEM_ROOT__/packages/orchestration</string>
    <key>PYTHON</key>
    <string>__SYSTEM_PYTHON__</string>
    <!-- SENTRY_DSN/Telegram tokens and the explicit Telegram proxy are loaded
         from this mode-600 file by the wrapper; never persist secrets in a
         tracked or installed plist. -->
    <key>SENTRY_ENVIRONMENT</key>
    <string>system-launchd</string>
    <key>SYSTEM_OBSERVABILITY_SECRETS_FILE</key>
    <string>/Users/a1/.config/system/observability.env</string>
    <!-- Explicit opt-in proxies; installer fills these from operator config.
         The gateway still uses trust_env=False and only reads these named
         values for registered provider endpoints. -->
    <key>HARVESTER_HTTP_PROXY_URL</key>
    <string></string>
    <key>HARVESTER_CFTC_PROXY_URL</key>
    <string></string>
    <!-- Concurrent provider families remain opt-in during Phase 1 closeout;
         enable only after the controlled scheduled-observation gate. -->
    <key>SYSTEM_HARVESTER_CONCURRENT</key>
    <string>0</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <!-- launchd soft maxfiles defaults ~256; harvester/yfinance need headroom -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>65536</integer>
  </dict>
</dict>
</plist>
