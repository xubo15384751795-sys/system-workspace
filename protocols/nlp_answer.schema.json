{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbench NLP Answer",
  "type": "object",
  "required": ["schema_version", "question", "answer", "citations", "limits", "context_budget"],
  "properties": {
    "schema_version": {"const": "workbench.nlp_answer.v1"},
    "question": {"type": "string"},
    "answer": {"type": "string"},
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "path", "excerpt"],
        "properties": {
          "evidence_id": {"type": "string"},
          "evidence_kind": {
            "type": "string",
            "const": "RETRIEVAL_CITATION",
            "description": "Content-stable retrieval reference, not a canonical Evidence object."
          },
          "canonical_evidence": {"const": false},
          "promotion_allowed": {"const": false},
          "path": {"type": "string"},
          "title": {"type": "string"},
          "release_id": {"type": "string"},
          "excerpt": {"type": "string"}
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {"type": "string"}
    },
    "context_budget": {
      "type": "object",
      "required": ["chunk_window_chars", "excerpt_chars", "top_k", "top_k_max"],
      "properties": {
        "chunk_window_chars": {"type": "integer"},
        "excerpt_chars": {"type": "integer"},
        "top_k": {"type": "integer"},
        "top_k_max": {"type": "integer"}
      }
    },
    "evidence_boundary": {
      "type": "string",
      "const": "retrieval_citation_only",
      "description": "Workbench NLP citations cannot be consumed as current canonical Evidence."
    },
    "prompt_sections": {
      "type": "object",
      "description": "Optional modular fragments (constitution, evidence_grounding, task, evidence_digest).",
      "additionalProperties": {"type": "string"}
    },
    "assembled_prompt": {
      "type": "string",
      "description": "Optional full prompt with PROMPT_DYNAMIC_BOUNDARY before dynamic evidence."
    }
  },
  "additionalProperties": false
}
