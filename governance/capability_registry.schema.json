{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability Registry",
  "description": "Schema for governance/capability_registry.yaml — single source of truth for module status",
  "type": "object",
  "additionalProperties": {"$ref": "#/$defs/module_entry"},
  "$defs": {
    "status_enum": {
      "type": "string",
      "enum": [
        "CANONICAL",
        "ACTIVE_PARTIAL",
        "REAL_EXPERIMENTAL",
        "PROTOTYPE_RETAIN",
        "PAPER_RETAIN",
        "BLOCKED",
        "FROZEN",
        "RETIRED",
        "UNKNOWN"
      ]
    },
    "audit_cadence_enum": {
      "type": "string",
      "enum": ["weekly", "biweekly", "monthly", "on_change"]
    },
    "module_entry": {
      "type": "object",
      "required": ["status", "owner", "last_verified"],
      "properties": {
        "status": {"$ref": "#/$defs/status_enum"},
        "owner": {"type": "string"},
        "producer": {
          "type": "array",
          "items": {"type": "string"}
        },
        "artifacts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "consumers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "allowed_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "forbidden_claims": {
          "type": "array",
          "items": {"type": "string"}
        },
        "blockers": {
          "type": "array",
          "items": {"type": "string"}
        },
        "last_verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "last_audit_method": {
          "type": "string"
        },
        "audit_cadence": {"$ref": "#/$defs/audit_cadence_enum"},
        "promotion_requirements": {
          "type": "array",
          "items": {"type": "string"}
        },
        "test_count": {
          "type": "integer",
          "minimum": 0
        },
        "test_location": {
          "type": "string"
        },
        "substatus": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "decision": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
