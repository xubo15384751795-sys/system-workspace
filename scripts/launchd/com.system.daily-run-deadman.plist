<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.system.daily-run-deadman</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SYSTEM_PYTHON__</string>
    <string>__SYSTEM_ROOT__/scripts/run_with_runtime_secrets.py</string>
    <string>__SYSTEM_PYTHON__</string>
    <string>__SYSTEM_ROOT__/scripts/check_daily_run_heartbeat.py</string>
