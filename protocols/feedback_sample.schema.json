{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feedback Sample",
  "description": "Schema for Feedback Sample Factory records. Each sample captures a point-in-time system judgment with forward outcome for calibration and governance learning. Not for model training — for decision calibration, rule evaluation, and feedback loops.",
  "type": "object",
  "required": [
    "schema_version",
    "sample_id",
    "as_of_date",
    "sample_type",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "feedback_sample.v1"
    },
    "sample_id": {
      "type": "string",
      "description": "Unique identifier: {as_of_date}_{sample_type}_{short_hash}"
    },
    "as_of_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "The date this sample represents — only data before this date was visible to the system"
    },
    "sample_type": {
      "type": "string",
      "enum": [
        "stress_window",
        "turning_point",
        "quiet_window",
        "false_alarm",
        "random",
        "event_window",
        "caselab_context",
        "real_judgment"
      ],
      "description": "Sampling category for stratified pool construction"
    },
    "why_selected": {
      "type": "string",
      "description": "Human-readable reason this date/event was selected for the sample pool"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO timestamp when this sample record was created"
    },
    "provider_status": {
      "type": "string",
      "enum": [
        "refreshed",
        "reused_same_content",
        "reused_after_provider_failure",
        "partial_provider_success",
        "provider_failed_no_acceptable_fallback",
        "no_release_expected",
        "environmentally_blocked"
      ],
      "description": "Provider outcome used by the versioned feedback eligibility matrix"
    },
    "provider_outcome": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "refreshed",
            "reused_same_content",
            "reused_after_provider_failure",
            "partial_provider_success",
            "provider_failed_no_acceptable_fallback",
            "no_release_expected",
            "environmentally_blocked"
          ]
        }
      },
      "additionalProperties": true
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "candidate",
        "eligible",
        "reviewed",
        "accepted",
        "rejected",
        "deferred",
        "calibration_set"
      ],
      "description": "Governed feedback lifecycle state; never an authority grant by itself"
    },
    "eligibility": {
      "type": "string",
      "enum": [
        "ineligible",
        "candidate",
        "eligible",
        "reviewed",
        "calibration_set",
        "deferred",
        "rejected"
      ],
      "description": "Explicit calibration eligibility state"
    },
    "eligibility_reason_codes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "cross_run": {
      "type": "boolean",
      "const": false,
      "description": "Must be false; cross-run samples are invalid evidence."
    },
    "future_leak": {
      "type": "boolean",
      "const": false,
      "description": "Must be false; future-leak samples are invalid evidence."
    },
    "allowed_to_affect_core_judgment": {
      "type": "boolean",
      "description": "Must remain false until a separately governed authority contract exists"
    },
    "calibration_set": {"type": "boolean"},
    "golden": {"type": "boolean"},
    "golden_adjudication": {
      "type": ["object", "null"],
      "description": "Versioned, separately adjudicated evidence required when golden is true",
      "properties": {
        "criteria_version": {"type": "string", "minLength": 1},
        "adjudicator": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["criteria_version", "adjudicator", "occurred_at", "evidence"],
      "additionalProperties": true
    },
    "lifecycle_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "from_state", "to_state", "owner", "occurred_at", "evidence"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "from_state": {
            "type": ["string", "null"],
            "enum": [null, "candidate", "eligible", "reviewed", "accepted", "rejected", "deferred", "calibration_set"]
          },
          "to_state": {
            "type": "string",
            "enum": ["candidate", "eligible", "reviewed", "accepted", "rejected", "deferred", "calibration_set"]
          },
          "owner": {"type": "string", "minLength": 1},
          "occurred_at": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": true
      }
    },
    "allowed_lookback": {
      "type": "string",
      "description": "Earliest date the system was allowed to use as input context"
    },
    "system_state": {
      "type": "object",
      "description": "Snapshot of system inputs visible at as_of_date",
      "properties": {
        "m_value": {"type": ["number", "null"]},
        "d_value": {"type": ["number", "null"]},
        "k_value": {"type": ["number", "null"]},
        "x_value": {"type": ["number", "null"]},
        "hmm_state": {"type": ["string", "null"]},
        "hmm_stability": {"type": ["string", "null"]},
        "caselab_top_score": {"type": ["number", "null"]},
        "caselab_top_case": {"type": ["string", "null"]},
        "data_freshness_hours": {"type": ["number", "null"]},
        "channel_coverage": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "system_judgment": {
      "type": "object",
      "description": "What the system produced at as_of_date",
      "properties": {
        "decision": {"type": "string"},
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "claim_tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Claim ladder tier: 0=observation, 1=mechanism_hypothesis, 2=watch_condition, 3=operational"
        },
        "claim_label": {"type": "string"},
        "claim_statement": {"type": "string"},
        "mechanism_hypothesis": {"type": "string"},
        "evidence_grade": {
          "type": "string",
          "enum": ["A", "B", "C", "D"]
        }
      },
      "additionalProperties": true
    },
    "conditions": {
      "type": "object",
      "description": "Watch and invalidation conditions at judgment time",
      "properties": {
        "watch_conditions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "invalidation_conditions": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "forward_outcome": {
      "type": "object",
      "description": "Market outcomes computed after the forward windows elapsed",
      "properties": {
        "computed_at": {"type": "string"},
        "spy": {
          "type": "object",
          "properties": {
            "pct_1d": {"type": ["number", "null"]},
            "pct_1w": {"type": ["number", "null"]},
            "pct_1m": {"type": ["number", "null"]},
            "pct_3m": {"type": ["number", "null"]}
          },
          "additionalProperties": true
        },
        "hyg": {
          "type": "object",
          "properties": {
            "pct_1d": {"type": ["number", "null"]},
            "pct_1w": {"type": ["number", "null"]},
            "pct_1m": {"type": ["number", "null"]},
            "pct_3m": {"type": ["number", "null"]}
          },
          "additionalProperties": true
        },
        "tlt": {
          "type": "object",
          "properties": {
            "pct_1d": {"type": ["number", "null"]},
            "pct_1w": {"type": ["number", "null"]},
            "pct_1m": {"type": ["number", "null"]},
            "pct_3m": {"type": ["number", "null"]}
          },
          "additionalProperties": true
        },
        "gld": {
          "type": "object",
          "properties": {
            "pct_1d": {"type": ["number", "null"]},
            "pct_1w": {"type": ["number", "null"]},
            "pct_1m": {"type": ["number", "null"]},
            "pct_3m": {"type": ["number", "null"]}
          },
          "additionalProperties": true
        },
        "vix": {
          "type": "object",
          "properties": {
            "level_at": {"type": ["number", "null"]},
            "change_1d": {"type": ["number", "null"]},
            "change_1w": {"type": ["number", "null"]},
            "change_1m": {"type": ["number", "null"]}
          },
          "additionalProperties": true
        },
        "move": {
          "type": "object",
          "properties": {
            "level_at": {"type": ["number", "null"]},
            "change_1w": {"type": ["number", "null"]},
            "change_1m": {"type": ["number", "null"]}
          },
          "additionalProperties": true
        },
        "max_drawdown_1m": {"type": ["number", "null"]},
        "stress_event_happened": {"type": ["boolean", "null"]},
        "invalidation_triggered": {"type": ["boolean", "null"]},
        "watch_condition_triggered": {"type": ["boolean", "null"]}
      },
      "additionalProperties": true
    },
    "review_label": {
      "type": "string",
      "enum": [
        "useful",
        "misleading",
        "too_early",
        "false_positive",
        "missed_stress",
        "correct_but_low_value",
        "needs_review",
        "not_evaluable"
      ],
      "description": "Feedback label — auto-assigned first, then human-verified"
    },
    "review_notes": {
      "type": "string",
      "description": "Human-readable explanation of why this label was assigned"
    },
    "auto_label_reason": {
      "type": "string",
      "description": "Why the auto-labeler assigned this label (before human review)"
    },
    "source_judgment_path": {
      "type": "string",
      "description": "Path to the original judgment card JSON if sourced from real daily output"
    },
    "event_context": {
      "type": "object",
      "description": "For event_window samples: what event was happening",
      "properties": {
        "event_type": {"type": "string"},
        "event_description": {"type": "string"},
        "event_source": {"type": "string"}
      },
      "additionalProperties": true
    },
    "operator_activations": {
      "type": "object",
      "description": "Mechanism operator activation snapshot at judgment time (research-only)"
    },
    "closure_loop": {
      "type": "object",
      "description": "Feedback closure fields for calibration and operator/proxy/gate fixes",
      "properties": {
        "failure_reason": {"type": ["string", "null"]},
        "suggested_fix": {
          "type": "object",
          "properties": {
            "operator": {"type": ["string", "null"]},
            "proxy": {"type": ["string", "null"]},
            "gate": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "human_review_required": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"golden": {"const": true}},
        "required": ["golden"]
      },
      "then": {
        "required": ["golden_adjudication"],
        "properties": {
          "golden_adjudication": {
            "type": "object"
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
