<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Phase 0.3 + 2.3 STAGED plist (not yet installed).
     To apply: ./scripts/install_launchd_plists.sh
     Changes vs the currently-installed agent:
       0.3: adds --skip-harvester so the 21:30 run does NOT re-fetch Yahoo
            (the 22:30 run is the authoritative daily harvester). Eliminates
            the self-rate-limit from two back-to-back full fetches.
       2.3: redirects logs from /tmp/ to Output/logs/launchd/ (versioned,
            monthly-truncated by daily_run startup). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.system.daily-run-harvester-postclose</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.14/bin/python3</string>
        <string>/Users/a1/System/scripts/daily_run.py</string>
        <string>--skip-harvester</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/a1/System/system-learning-hub/src</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <!-- 21:30 UTC (05:30+1 CST) - US market close; downstream-only (skip harvester) -->
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/a1/System</string>
    <key>StandardOutPath</key>
    <string>/Users/a1/System/Output/logs/launchd/daily_run_harvester_postclose.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/a1/System/Output/logs/launchd/daily_run_harvester_postclose.log</string>
</dict>
</plist>
