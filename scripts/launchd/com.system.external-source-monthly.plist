<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.system.external-source-monthly</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SYSTEM_PYTHON__</string>
    <string>__SYSTEM_ROOT__/scripts/check_external_source_endpoints.py</string>
    <string>--json</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>WorkingDirectory</key>
  <string>__SYSTEM_ROOT__</string>
  <key>StandardOutPath</key>
  <string>__SYSTEM_ROOT__/Output/runs/external-source-monthly.log</string>
  <key>StandardErrorPath</key>
  <string>__SYSTEM_ROOT__/Output/runs/external-source-monthly.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SYSTEM_ROOT</key>
    <string>__SYSTEM_ROOT__</string>
  </dict>
</dict>
</plist>
