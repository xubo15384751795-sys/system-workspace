{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System Status Card",
  "description": "Schema for Output/current/status.json — produced by build_current_status.py gather_status(). Previously named current_card; renamed to reflect actual structure.",
  "type": "object",
  "required": ["generated_at", "date", "judgment", "promotion_gate", "signals"],
  "properties": {
    "generated_at": {"type": "string"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "judgment": {
      "type": "object",
      "required": ["decision", "confidence"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "WATCH_ONLY",
            "RESEARCH_REVIEW",
            "ACTIVE_WATCH",
            "STRONG_BUY",
            "BUY",
            "HOLD",
            "NO_TRADE",
            "RESEARCH_ONLY",
            "STRONG_SELL",
            "SELL"
          ],
          "description": "Authority: governance/runtime_status_contract.yaml judgment_decision"
        },
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "claim_ceiling": {"type": "string"},
        "judgment_id": {"type": ["string", "null"], "pattern": "^jud_[0-9a-f]{32}$"},
        "claim_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^clm_[0-9a-f]{32}$"}
        },
        "supporting_claim_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^clm_[0-9a-f]{32}$"}
        },
        "conflicting_claim_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^clm_[0-9a-f]{32}$"}
        },
        "research_only_claim_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^clm_[0-9a-f]{32}$"}
        },
        "lineage_complete": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "promotion_gate": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string"},
        "blocked_gates": {"type": "array", "items": {"type": "string"}},
        "watch_gates": {"type": "array", "items": {"type": "string"}},
        "blocking_reasons": {"type": "array", "items": {"type": "string"}},
        "watch_reasons": {"type": "array", "items": {"type": "string"}},
        "forbidden_language": {"type": "array", "items": {"type": "string"}},
        "allowed_language": {"type": "array", "items": {"type": "string"}},
        "epistemic_authority": {"type": "string", "enum": ["ALLOW", "DIAGNOSTIC_ONLY", "BLOCK"]}
      },
      "additionalProperties": true
    },
    "signals": {
      "type": "object",
      "properties": {
        "k_gate": {"type": "object"},
        "x_gate": {"type": "object"},
        "hmm": {"type": "object"},
        "caselab": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
