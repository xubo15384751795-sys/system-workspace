<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.system.caffeinate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>__SYSTEM_ROOT__</string>
  <key>StandardOutPath</key>
  <string>__SYSTEM_ROOT__/Output/runs/launchd-caffeinate.log</string>
  <key>StandardErrorPath</key>
  <string>__SYSTEM_ROOT__/Output/runs/launchd-caffeinate.err.log</string>
</dict>
</plist>
