<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Legacy post-close agent retained as an auditable, disabled record.
     It previously repeated an authoritative current publish.
     Apply via: bash scripts/install_launchd_plists.sh apply flag. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.system.daily-run-harvester-postclose</string>
    <key>Disabled</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>__SYSTEM_PYTHON__</string>
        <string>/Users/a1/System/scripts/daily_run.py</string>
        <string>--skip-harvester</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Users/a1/System/system-learning-hub/src</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <!-- Historical slot; disabled until an explicit session-gated consumer exists. -->
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>WorkingDirectory</key>
    <string>/Users/a1/System</string>
    <key>StandardOutPath</key>
    <string>/Users/a1/System/Output/logs/launchd/daily_run_harvester_postclose.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/a1/System/Output/logs/launchd/daily_run_harvester_postclose.log</string>
    <!-- launchd soft maxfiles defaults near 256; harvester/yfinance need headroom -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>65536</integer>
    </dict>
</dict>
</plist>
