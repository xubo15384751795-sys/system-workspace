{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system.plan.v1",
  "title": "System compiled plan artifact",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "profile",
    "created_at",
    "code_sha",
    "plan_digest",
    "policy_digest",
    "code_digest",
    "input_contract_digest",
    "steps",
    "edges"
  ],
  "properties": {
    "schema_version": {"const": "system.plan.v1"},
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "code_sha": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "steps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "edges": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      }
    }
  },
  "additionalProperties": false
}
