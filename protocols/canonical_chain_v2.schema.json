{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "system.canonical_chain.v2",
  "title": "Canonical chain delta + digest envelope",
  "description": "Per-dataset lineage sidecar for v2 storage. JSONL lines remain system.canonical_chain.v1 records. Wave 2 moves this store into DuckDB lineage tables.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_schema_version",
    "dataset_id",
    "release_id",
    "storage_mode",
    "observations",
    "chains"
  ],
  "properties": {
    "schema_version": { "const": "system.canonical_chain.v2" },
    "record_schema_version": { "const": "system.canonical_chain.v1" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"
    },
    "previous_release_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-9][0-9]*$"
    },
    "storage_mode": { "type": "string", "enum": ["full", "delta"] },
    "wave2_successor": { "type": "string", "const": "duckdb_lineage_tables" },
    "observations": { "$ref": "#/$defs/section" },
    "chains": { "$ref": "#/$defs/section" },
    "previous_observation_merkle_root": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_chain_merkle_root": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "tombstones": {
      "type": "array",
      "description": "Logical keys present in the previous release and absent from this one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonical_series_id", "observed_at"],
        "properties": {
          "canonical_series_id": { "type": "string", "minLength": 1 },
          "observed_at": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "delta_count", "full_count", "sha256", "merkle_root"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["full", "delta"] },
        "delta_count": { "type": "integer", "minimum": 0 },
        "full_count": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "merkle_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
